<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Silent pushes from the CloudKit subscription when a Mac writes. -->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.bar.quota.QuotaBar</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- The Mac's Developer ID build can only use Production, so every
	     build of the phone app does too, or a debug build would read an
	     empty Development database. -->
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
	<!-- The readings cache the widgets draw from. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.bar.quota.QuotaBar</string>
	</array>
</dict>
</plist>
